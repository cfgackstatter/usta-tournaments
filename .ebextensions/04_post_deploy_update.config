# .ebextensions/04_post_deploy_update.config
# System libs for Chromium only. Do NOT run `playwright install` or scrapers here —
# on t3a.small that exceeds EB's command timeout (~15m) and aborts the deploy.
# Browsers are installed lazily by /usr/local/bin/update_itf.sh on first ITF update.
commands:
  00_install_chromium_deps:
    command: |
      dnf install -y \
        atk \
        gtk3 \
        libX11 \
        libXcomposite \
        libXcursor \
        libXdamage \
        libXext \
        libXi \
        libXrandr \
        libXScrnSaver \
        libXxf86vm \
        pango \
        alsa-lib \
        nss
    ignoreErrors: false
