# .ebextensions/02_cron.config

commands:
  01_enable_crond:
    command: "systemctl enable crond.service"
    ignoreErrors: false
  02_start_crond:
    command: "systemctl start crond.service || service crond start"
    ignoreErrors: false
  03_verify_crond:
    command: "systemctl is-active crond.service"
    ignoreErrors: false
  04_remove_old_cron:
    command: "rm -f /etc/cron.d/app_update_job.bak"
    ignoreErrors: true
  05_reload_cron:
    command: "systemctl reload crond || service crond reload || systemctl restart crond"
    ignoreErrors: false

files:
  "/etc/cron.d/app_update_job":
    mode: "000644"
    owner: root
    group: root
    content: |
      # USTA: daily at midnight UTC
      0 0 * * * root /usr/local/bin/update_usta.sh >> /var/log/app-updates.log 2>&1
      # UTR: daily at 12:30am UTC
      30 0 * * * root /usr/local/bin/update_utr.sh >> /var/log/app-updates.log 2>&1
      # ITF: weekly on Monday at 1am UTC
      0 1 * * 1 root /usr/local/bin/update_itf.sh >> /var/log/app-updates.log 2>&1

  "/usr/local/bin/update_usta.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCK_FILE=/var/lock/update_usta.lock
      exec 9>"$LOCK_FILE"
      if ! flock -n 9; then
        echo "===== USTA update skipped (already running) at $(date) =====" >> /var/log/app-updates.log
        exit 0
      fi

      cd /var/app/current || exit 1
      source /var/app/venv/*/bin/activate
      export PYTHONPATH="/var/app/current:/var/app/current/backend:${PYTHONPATH:-}"
      export APP_DATA_DIR="/var/app/shared/data"

      echo "===== USTA update started at $(date) =====" >> /var/log/app-updates.log
      if python3 -m backend.main --update-usta --max-pages "${CRON_USTA_MAX_PAGES:-100}" >> /var/log/app-updates.log 2>&1; then
        echo "OK USTA update successful at $(date)" >> /var/log/app-updates.log
      else
        echo "FAIL USTA update failed at $(date)" >> /var/log/app-updates.log
        exit 1
      fi
      echo "" >> /var/log/app-updates.log

  "/usr/local/bin/update_utr.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCK_FILE=/var/lock/update_utr.lock
      exec 9>"$LOCK_FILE"
      if ! flock -n 9; then
        echo "===== UTR update skipped (already running) at $(date) =====" >> /var/log/app-updates.log
        exit 0
      fi

      cd /var/app/current || exit 1
      source /var/app/venv/*/bin/activate
      export PYTHONPATH="/var/app/current:/var/app/current/backend:${PYTHONPATH:-}"
      export APP_DATA_DIR="/var/app/shared/data"

      echo "===== UTR update started at $(date) =====" >> /var/log/app-updates.log
      if python3 -m backend.main --update-utr --max-pages "${CRON_UTR_MAX_PAGES:-20}" >> /var/log/app-updates.log 2>&1; then
        echo "OK UTR update successful at $(date)" >> /var/log/app-updates.log
      else
        echo "FAIL UTR update failed at $(date)" >> /var/log/app-updates.log
        exit 1
      fi
      echo "" >> /var/log/app-updates.log

  "/usr/local/bin/update_itf.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      LOCK_FILE=/var/lock/update_itf.lock
      exec 9>"$LOCK_FILE"
      if ! flock -n 9; then
        echo "===== ITF update skipped (already running) at $(date) =====" >> /var/log/app-updates.log
        exit 0
      fi

      cd /var/app/current || exit 1
      source /var/app/venv/*/bin/activate
      export PYTHONPATH="/var/app/current:/var/app/current/backend:${PYTHONPATH:-}"
      export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-/var/app/shared/ms-playwright}"
      export APP_DATA_DIR="/var/app/shared/data"
      mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"

      # Install Chromium outside deploy — first run on t3a.small can take a long time
      if [ ! -d "$PLAYWRIGHT_BROWSERS_PATH" ] || ! find "$PLAYWRIGHT_BROWSERS_PATH" -type f -name chrome -print -quit | grep -q .; then
        echo "===== Installing Playwright Chromium at $(date) =====" >> /var/log/app-updates.log
        python3 -m playwright install chromium >> /var/log/app-updates.log 2>&1
      fi

      echo "===== ITF update started at $(date) =====" >> /var/log/app-updates.log
      if python3 -m backend.main --update-itf --months-back 0 --months-ahead "${CRON_ITF_MONTHS_AHEAD:-12}" >> /var/log/app-updates.log 2>&1; then
        echo "OK ITF update successful at $(date)" >> /var/log/app-updates.log
      else
        echo "FAIL ITF update failed at $(date)" >> /var/log/app-updates.log
        exit 1
      fi
      echo "" >> /var/log/app-updates.log
